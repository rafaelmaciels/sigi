{# templates/financeiro/entradas.html #}
{% extends "base.html" %}
{% block title %}Entradas{% endblock %}

{% block content %}
<div class="container mt-4">
  <h2 class="mb-4"><i class="bi bi-arrow-down-circle text-success"></i> Entradas (Receitas)</h2>

  {% if has_permission("financeiro", "create") %}
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <form method="POST">
          {{ form.hidden_tag() }}
          <div class="row g-3">
            <div class="col-md-3">
              {{ form.tipo_receita.label(class="form-label") }}
              {{ form.tipo_receita(class="form-select") }}
            </div>
            <div class="col-md-3">
              {{ form.valor.label(class="form-label") }}
              {{ form.valor(class="form-control", placeholder="0.00") }}
            </div>
            <div class="col-md-3">
              {{ form.data.label(class="form-label") }}
              {{ form.data(class="form-control", placeholder="dd/mm/aaaa") }}
            </div>
            <div class="col-md-3">
              {{ form.conta.label(class="form-label") }}
              {{ form.conta(class="form-select") }}
            </div>
            <div class="col-12">
              {{ form.descricao.label(class="form-label") }}
              {{ form.descricao(class="form-control", placeholder="Descrição (opcional)") }}
            </div>
          </div>
          <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-success">
              <i class="bi bi-check-circle"></i> Salvar
            </button>
            <a href="{{ url_for('financeiro.financeiro') }}" class="btn btn-secondary">
              <i class="bi bi-x-circle"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  {% endif %}

  {% if has_permission("financeiro", "view") %}
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title">Histórico de Entradas</h5>
        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead>
              <tr>
                <th>Data</th>
                <th>Tipo</th>
                <th>Conta</th>
                <th>Descrição</th>
                <th>Valor (R$)</th>
                {% if has_permission("financeiro", "edit") or has_permission("financeiro", "delete") %}
                  <th>Ações</th>
                {% endif %}
              </tr>
            </thead>
            <tbody>
              {% if entradas %}
                {% for r in entradas %}
                <tr>
                  <td>{{ r.data.strftime('%d/%m/%Y') }}</td>
                  <td>{{ r.categoria }}</td>
                  <td>{{ r.conta }}</td>
                  <td>{{ r.descricao or '-' }}</td>
                  <td>
                    {{ ("R$ {:,.2f}".format(r.valor)).replace(",", "X").replace(".", ",").replace("X", ".") }}
                  </td>
                  {% if has_permission("financeiro", "edit") or has_permission("financeiro", "delete") %}
                    <td>
                      {% if has_permission("financeiro", "edit") %}
                        <a href="{{ url_for('financeiro.editar_entrada', id=r.id) }}" class="btn btn-sm btn-outline-warning">
                          <i class="bi bi-pencil-square"></i> Editar
                        </a>
                      {% endif %}
                      {% if has_permission("financeiro", "delete") %}
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDelete{{ r.id }}">
                          <i class="bi bi-trash"></i> Excluir
                        </button>
                      {% endif %}
                    </td>
                  {% endif %}
                </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td colspan="6" class="text-center text-muted">Nenhuma entrada registrada.</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  {% endif %}
</div>
{% endblock %}

{% block modals %}
  {% for r in entradas %}
    {% if has_permission("financeiro", "delete") %}
      <div class="modal fade" id="confirmDelete{{ r.id }}" tabindex="-1" aria-labelledby="confirmDeleteLabel{{ r.id }}" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header bg-gradient-base">
              <h5 class="modal-title" id="confirmDeleteLabel{{ r.id }}">Confirmar Exclusão</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
              Tem certeza que deseja excluir a entrada de <strong>{{ r.data.strftime('%d/%m/%Y') }}</strong> no valor de 
              <strong>{{ ("R$ {:,.2f}".format(r.valor)).replace(",", "X").replace(".", ",").replace("X", ".") }}</strong>?<br>
              Esta ação não poderá ser desfeita.
            </div>
            <div class="modal-footer">
              <form method="POST" action="{{ url_for('financeiro.excluir_entrada', id=r.id) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="btn btn-danger">
                  <i class="bi bi-trash me-1"></i> Excluir
                </button>
              </form>
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="bi bi-x-circle me-1"></i> Cancelar
              </button>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
{% endblock %}
