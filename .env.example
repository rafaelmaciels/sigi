# ==============================================================================
# 🏛️ SiGI — Sistema Integrado de Gestão de Igreja
# Template de Variáveis de Ambiente (.env.example)
#
# INSTRUÇÕES:
# 1. Copie este arquivo para '.env':
#    cp .env.example .env
# 2. Preencha ou altere os valores conforme o ambiente (Desenvolvimento ou Produção).
# 3. NUNCA envie o arquivo '.env' preenchido para o Git ou repositório público.
# ==============================================================================

# -----------------------------
# 🌐 Ambiente e Segurança
# -----------------------------
# Opções: 'production' ou 'development'
FLASK_ENV=production

# Chave secreta da aplicação (essencial para assinatura de cookies e CSRF).
# GERE UMA CHAVE FORTE com o comando: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=altere-esta-chave-secreta-em-producao-gerando-um-token-aleatorio-seguro

# Fuso horário padrão do sistema
APP_TIMEZONE=America/Sao_Paulo

# -----------------------------
# 🗄️ Banco de Dados (SQLAlchemy)
# -----------------------------
# Opção 1: SQLite (Padrão para desenvolvimento ou pequenas congregações no PythonAnywhere)
DATABASE_URL=sqlite:///instance/sigi.db

# Opção 2: MySQL / MariaDB (Recomendado para servidores compartilhados cPanel ou produção de médio/grande porte)
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://usuario_banco:senha_forte@localhost:3306/sigi_db?charset=utf8mb4

# -----------------------------
# 📂 Uploads e Armazenamento
# -----------------------------
# Caminho relativo ou absoluto para a pasta de arquivos enviados (fotos, comprovantes)
UPLOAD_FOLDER=app/static/uploads

# Tamanho máximo permitido para upload em Megabytes (MB)
MAX_CONTENT_LENGTH_MB=10

# -----------------------------
# ⏱️ Sessão e Cookies
# -----------------------------
# Tempo de expiração da sessão inativa em minutos
SESSION_TIMEOUT=60

# Duração do cookie "Lembrar de mim" em dias
REMEMBER_DAYS=7

# -----------------------------
# 📧 Configuração de E-mail (SMTP)
# -----------------------------
# Necessário para envio de lembretes de eventos e recuperação de senha.
MAIL_SERVER=smtp.exemplo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=notificacoes@suaigreja.com.br
MAIL_PASSWORD=sua-senha-smtp-segura
MAIL_DEFAULT_NAME=Secretaria SiGI
MAIL_DEFAULT_EMAIL=notificacoes@suaigreja.com.br

# -----------------------------
# 📝 Logs e Diagnóstico
# -----------------------------
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
